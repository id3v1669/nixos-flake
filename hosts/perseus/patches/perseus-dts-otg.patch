@@ -13,6 +13,7 @@
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/usb/pd.h>
 #include <dt-bindings/input/linux-event-codes.h>
 #include <dt-bindings/sound/qcom,q6afe.h>
 #include <dt-bindings/sound/qcom,q6asm.h>
@@ -860,10 +861,9 @@
 };
 
 &usb_1_dwc3 {
-	/*
-	 * We don't have the capability to switch modes yet.
-	 */
-	dr_mode = "peripheral";
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
 
 	/* fastest mode for USB 2 */
 	maximum-speed = "high-speed";
@@ -873,6 +873,57 @@
 	phy-names = "usb2-phy";
 };
 
+&usb_1_dwc3_hs {
+	remote-endpoint = <&pmi_con_hs>;
+};
+
+/* PMI8998 Type-C + USB-PD port (tcpm). CC in the charger USBIN peripheral (0x1300),
+ * PD-PHY at 0x1700. */
+&pmi8998_lsid0 {
+	pmi8998_typec: typec@1300 {
+		compatible = "qcom,pmi8998-typec";
+		reg = <0x1300>, <0x1700>;
+		interrupts = <0x2 0x13 0x7 IRQ_TYPE_EDGE_RISING>,
+			     <0x2 0x17 0x0 IRQ_TYPE_EDGE_RISING>,
+			     <0x2 0x17 0x1 IRQ_TYPE_EDGE_RISING>,
+			     <0x2 0x17 0x2 IRQ_TYPE_EDGE_RISING>,
+			     <0x2 0x17 0x3 IRQ_TYPE_EDGE_RISING>,
+			     <0x2 0x17 0x4 IRQ_TYPE_EDGE_RISING>,
+			     <0x2 0x17 0x5 IRQ_TYPE_EDGE_RISING>,
+			     <0x2 0x17 0x6 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "type-c-change",
+				  "sig-tx", "sig-rx", "msg-tx", "msg-rx",
+				  "msg-tx-fail", "msg-tx-discard", "msg-rx-discard";
+		vdd-pdphy-supply = <&vreg_l24a_3p075>;
+
+		connector {
+			compatible = "usb-c-connector";
+			power-role = "dual";
+			data-role = "dual";
+			try-power-role = "sink";
+			source-pdos = <PDO_FIXED(5000, 900,
+					PDO_FIXED_DUAL_ROLE | PDO_FIXED_USB_COMM |
+					PDO_FIXED_DATA_SWAP)>;
+			sink-pdos = <PDO_FIXED(5000, 3000,
+					PDO_FIXED_DUAL_ROLE | PDO_FIXED_USB_COMM |
+					PDO_FIXED_DATA_SWAP)
+				     PDO_VAR(5000, 12000, 3000)>;
+			op-sink-microwatt = <10000000>;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+				port@0 {
+					reg = <0>;
+					pmi_con_hs: endpoint {
+						remote-endpoint = <&usb_1_dwc3_hs>;
+					};
+				};
+			};
+		};
+	};
+};
+
 &usb_1_hsphy {
 	vdd-supply = <&vreg_l1a_0p875>;
 	vdda-pll-supply = <&vreg_l12a_1p8>;
