+static int pmic_pdphy_trims_show(struct seq_file *s, void *unused)
+{
+	struct pmic_typec_pdphy *p = g_poke_pdphy;
+	int i;
+
+	if (!p)
+		return -ENODEV;
+	for (i = 0; i < p->poke_count; i++)
+		seq_printf(s, "%02x:%02x ", p->poke_reg[i], p->poke_val[i]);
+	seq_putc(s, '\n');
+	return 0;
+}
+
+static int pmic_pdphy_trims_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, pmic_pdphy_trims_show, NULL);
