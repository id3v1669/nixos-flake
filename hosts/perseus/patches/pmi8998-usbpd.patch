+/*
+ * Debugfs poke harness (single pdphy instance). Write a space/comma separated
+ * list of hex "reg:val" trim pairs (offsets within the pdphy peripheral, e.g.
+ * "f3:02 f0:05"); they are applied behind SEC_ACCESS on every subsequent enable.
+ * Empty write clears the list. Read shows the pending list (not the hardware).
+ */
+static struct pmic_typec_pdphy *g_poke_pdphy;
+
+static ssize_t pmic_pdphy_trims_write(struct file *file, const char __user *ubuf,
+				      size_t len, loff_t *ppos)
+{
+	struct pmic_typec_pdphy *p = g_poke_pdphy;
+	char buf[256], *s, *tok;
+	unsigned int reg, val;
+	int n = 0;
+
+	if (!p)
+		return -ENODEV;
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	s = buf;
+	while ((tok = strsep(&s, " ,\n\t")) != NULL) {
+		if (*tok == '\0')
+			continue;
+		if (sscanf(tok, "%x:%x", &reg, &val) != 2 || reg > 0xff || val > 0xff)
+			return -EINVAL;
+		if (n >= PMIC_PDPHY_POKE_MAX)
+			return -E2BIG;
+		p->poke_reg[n] = reg;
+		p->poke_val[n] = val;
+		n++;
+	}
+	p->poke_count = n;
+	return len;
+}
