diff -ruN a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port_pmi8998.c b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port_pmi8998.c
--- a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port_pmi8998.c	1970-01-01 08:00:00.000000000 +0800
+++ b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port_pmi8998.c	2026-07-12 15:40:34.120752410 +0800
@@ -0,0 +1,447 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PMI8998 Type-C CC/port backend for qcom_pmic_typec.
+ *
+ * The PMI8998 uses the older qpnp-smb2 Type-C block, inside the charger's
+ * USBIN peripheral (base 0x1300), with a SINGLE "type-c-change" interrupt and
+ * a register layout distinct from the pm8150b backend. VBUS as a source is the
+ * PMIC OTG boost (OTG peripheral 0x1100), enabled with the current-stepping
+ * soft-start workaround. Structure mirrors qcom_pmic_typec_port.c.
+ */
+
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+#include <linux/usb/tcpm.h>
+#include <linux/usb/typec.h>
+
+#include "qcom_pmic_typec.h"
+#include "qcom_pmic_typec_port.h"
+
+/* CC status (base-relative, base = 0x1300) */
+#define PMI_MISC_STATUS			0x0e
+#define  CC_ATTACHED			BIT(0)
+#define  CC_ORIENTATION			BIT(1)
+#define  TYPEC_DEBOUNCE_DONE		BIT(4)
+#define  TYPEC_VBUS			BIT(6)
+#define  DFP_MODE			BIT(7)	/* set: we source (Rp), device attached */
+#define PMI_SNK_STATUS			0x0b	/* as sink: detected source Rp */
+#define  UFP_TYPEC_MASK			GENMASK(7, 5)
+#define  UFP_RDSTD			BIT(7)
+#define  UFP_RD1P5			BIT(6)
+#define  UFP_RD3P0			BIT(5)
+#define PMI_SRC_STATUS			0x0c	/* as source: detected sink Rd */
+#define  DFP_TYPEC_MASK			GENMASK(3, 0)
+#define  DFP_RD_OPEN			BIT(3)
+#define  DFP_RD_RA_VCONN		BIT(2)
+#define  DFP_RD_RD			BIT(1)
+#define  DFP_RA_RA			BIT(0)
+
+/* Type-C config */
+#define PMI_TYPE_C_CFG_2		0x59
+#define  EN_80UA_180UA_CUR_SOURCE	BIT(0)	/* 0: 80uA (def), 1: 180uA (1.5A) */
+
+/* Power role + VCONN software control */
+#define PMI_PWR_ROLE_CTRL		0x68
+#define  VCONN_EN_ORIENTATION		BIT(6)
+#define  VCONN_EN_SRC			BIT(4)
+#define  VCONN_EN_VALUE			BIT(3)
+#define  TYPEC_PWR_ROLE_MASK		GENMASK(2, 0)
+#define  UFP_EN_CMD			BIT(2)	/* present Rd: sink */
+#define  DFP_EN_CMD			BIT(1)	/* present Rp: source */
+#define  TYPEC_DISABLE_CMD		BIT(0)
+
+/* Type-C interrupt event enables */
+#define PMI_INTRPT_ENB			0x67
+
+/* OTG boost (VBUS source), OTG peripheral base 0x1100 */
+#define OTG_CMD				0x40
+#define  OTG_EN				BIT(0)
+#define OTG_CURRENT_LIMIT		0x52
+#define  OTG_CURRENT_LIMIT_MASK		GENMASK(2, 0)
+#define OTG_STATUS			0x09
+#define  BOOST_SOFTSTART_DONE		BIT(3)
+
+struct pmic_typec_port_irq_data {
+	int				virq;
+	int				irq;
+	struct pmic_typec_port		*pmic_typec_port;
+};
+
+struct pmic_typec_port {
+	struct device			*dev;
+	struct tcpm_port		*tcpm_port;
+	struct regmap			*regmap;
+	u32				base;		/* CC/USBIN, 0x1300 */
+	u32				otg_base;	/* OTG boost, 0x1100 */
+	unsigned int			nr_irqs;
+	struct pmic_typec_port_irq_data	*irq_data;
+	bool				vbus_enabled;
+	struct mutex			vbus_lock;	/* VBUS state serialization */
+	spinlock_t			lock;		/* register atomicity */
+	struct delayed_work		attach_sync_work; /* already-attached CC sync */
+};
+
+/* Enable the OTG boost for source VBUS (current-stepping soft-start). */
+static int pmi_enable_otg(struct pmic_typec_port *p)
+{
+	static const u8 cl_steps[] = { 0x0, 0x1, 0x3, 0x5 };
+	unsigned int stat;
+	int i, retry, ret;
+
+	for (i = 0; i < ARRAY_SIZE(cl_steps); i++) {
+		regmap_update_bits(p->regmap, p->otg_base + OTG_CURRENT_LIMIT,
+				   OTG_CURRENT_LIMIT_MASK, cl_steps[i]);
+		regmap_update_bits(p->regmap, p->otg_base + OTG_CMD, OTG_EN, OTG_EN);
+		for (retry = 0; retry < 20; retry++) {
+			usleep_range(2000, 2100);
+			ret = regmap_read(p->regmap, p->otg_base + OTG_STATUS, &stat);
+			if (ret)
+				return ret;
+			if (stat & BOOST_SOFTSTART_DONE)
+				return 0;
+		}
+		regmap_update_bits(p->regmap, p->otg_base + OTG_CMD, OTG_EN, 0);
+	}
+	dev_warn(p->dev, "OTG boost soft-start failed\n");
+	return -EIO;
+}
+
+static int pmi_typec_get_cc(struct tcpc_dev *tcpc,
+			    enum typec_cc_status *cc1,
+			    enum typec_cc_status *cc2)
+{
+	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
+	struct pmic_typec_port *p = tcpm->pmic_typec_port;
+	unsigned int misc, sts;
+	enum typec_cc_status val = TYPEC_CC_OPEN;
+	int ret;
+
+	*cc1 = TYPEC_CC_OPEN;
+	*cc2 = TYPEC_CC_OPEN;
+
+	ret = regmap_read(p->regmap, p->base + PMI_MISC_STATUS, &misc);
+	if (ret)
+		return ret;
+	if (!(misc & CC_ATTACHED))
+		return 0;
+
+	if (misc & DFP_MODE) {
+		/* we are the source; read detected Rd on the sink */
+		ret = regmap_read(p->regmap, p->base + PMI_SRC_STATUS, &sts);
+		if (ret)
+			return ret;
+		if (sts & DFP_RA_RA) {
+			*cc1 = *cc2 = TYPEC_CC_RA;
+			return 0;
+		} else if (sts & DFP_RD_RA_VCONN) {
+			val = TYPEC_CC_RD;
+			*cc1 = *cc2 = TYPEC_CC_RA;
+		} else {
+			val = TYPEC_CC_RD;	/* RD_OPEN / RD_RD */
+		}
+	} else {
+		/* we are the sink; read detected Rp on the source */
+		ret = regmap_read(p->regmap, p->base + PMI_SNK_STATUS, &sts);
+		if (ret)
+			return ret;
+		if (sts & UFP_RD3P0)
+			val = TYPEC_CC_RP_3_0;
+		else if (sts & UFP_RD1P5)
+			val = TYPEC_CC_RP_1_5;
+		else
+			val = TYPEC_CC_RP_DEF;
+	}
+
+	if (misc & CC_ORIENTATION)
+		*cc2 = val;
+	else
+		*cc1 = val;
+	return 0;
+}
+
+static int pmi_typec_set_cc(struct tcpc_dev *tcpc, enum typec_cc_status cc)
+{
+	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
+	struct pmic_typec_port *p = tcpm->pmic_typec_port;
+	unsigned long flags;
+	u8 role;
+	int ret;
+
+	spin_lock_irqsave(&p->lock, flags);
+
+	switch (cc) {
+	case TYPEC_CC_RD:
+		role = UFP_EN_CMD;
+		break;
+	case TYPEC_CC_RP_DEF:
+	case TYPEC_CC_RP_1_5:
+	case TYPEC_CC_RP_3_0:
+		role = DFP_EN_CMD;
+		/* Rp advertisement: default (80uA) vs 1.5A (180uA) */
+		regmap_update_bits(p->regmap, p->base + PMI_TYPE_C_CFG_2,
+				   EN_80UA_180UA_CUR_SOURCE,
+				   cc == TYPEC_CC_RP_DEF ? 0 : EN_80UA_180UA_CUR_SOURCE);
+		break;
+	case TYPEC_CC_OPEN:
+	default:
+		role = TYPEC_DISABLE_CMD;
+		break;
+	}
+
+	ret = regmap_update_bits(p->regmap, p->base + PMI_PWR_ROLE_CTRL,
+				 TYPEC_PWR_ROLE_MASK, role);
+	spin_unlock_irqrestore(&p->lock, flags);
+	return ret;
+}
+
+static int pmi_typec_set_polarity(struct tcpc_dev *tcpc,
+				  enum typec_cc_polarity pol)
+{
+	/* USB2 D+/D- are fixed; no lane mux to route */
+	return 0;
+}
+
+static int pmi_typec_set_vconn(struct tcpc_dev *tcpc, bool on)
+{
+	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
+	struct pmic_typec_port *p = tcpm->pmic_typec_port;
+	unsigned int misc, orientation, mask, value;
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&p->lock, flags);
+	ret = regmap_read(p->regmap, p->base + PMI_MISC_STATUS, &misc);
+	if (ret)
+		goto done;
+	/* VCONN on the inactive CC line */
+	orientation = (misc & CC_ORIENTATION) ? 0 : VCONN_EN_ORIENTATION;
+	if (on) {
+		mask = VCONN_EN_ORIENTATION | VCONN_EN_VALUE;
+		value = orientation | VCONN_EN_VALUE | VCONN_EN_SRC;
+	} else {
+		mask = VCONN_EN_VALUE;
+		value = 0;
+	}
+	ret = regmap_update_bits(p->regmap, p->base + PMI_PWR_ROLE_CTRL,
+				 mask, value);
+done:
+	spin_unlock_irqrestore(&p->lock, flags);
+	return ret;
+}
+
+static int pmi_typec_get_vbus(struct tcpc_dev *tcpc)
+{
+	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
+	struct pmic_typec_port *p = tcpm->pmic_typec_port;
+	unsigned int misc;
+	int ret;
+
+	mutex_lock(&p->vbus_lock);
+	if (p->vbus_enabled) {
+		mutex_unlock(&p->vbus_lock);
+		return 1;
+	}
+	ret = regmap_read(p->regmap, p->base + PMI_MISC_STATUS, &misc);
+	mutex_unlock(&p->vbus_lock);
+	if (ret)
+		return ret;
+	return !!(misc & TYPEC_VBUS);
+}
+
+static int pmi_typec_set_vbus(struct tcpc_dev *tcpc, bool on, bool sink)
+{
+	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
+	struct pmic_typec_port *p = tcpm->pmic_typec_port;
+	int ret = 0;
+
+	mutex_lock(&p->vbus_lock);
+	if (p->vbus_enabled == on)
+		goto done;
+	if (on)
+		ret = pmi_enable_otg(p);
+	else
+		ret = regmap_update_bits(p->regmap, p->otg_base + OTG_CMD, OTG_EN, 0);
+	if (ret)
+		goto done;
+	p->vbus_enabled = on;
+	tcpm_vbus_change(tcpm->tcpm_port);
+done:
+	mutex_unlock(&p->vbus_lock);
+	return ret;
+}
+
+/*
+ * If a cable is already attached when toggling starts (e.g. the dock is
+ * connected across a reboot), no CC edge occurs, so the edge-triggered
+ * type-c-change IRQ never fires and tcpm would stay in TOGGLING forever.
+ * After start_toggling, sync the current attach state to tcpm out of line
+ * (process context, no locks held).
+ */
+static void pmi_typec_attach_sync_work(struct work_struct *work)
+{
+	struct pmic_typec_port *p =
+		container_of(work, struct pmic_typec_port, attach_sync_work.work);
+	unsigned int misc;
+
+	if (!p->tcpm_port)
+		return;
+	if (regmap_read(p->regmap, p->base + PMI_MISC_STATUS, &misc))
+		return;
+	if (misc & CC_ATTACHED) {
+		tcpm_cc_change(p->tcpm_port);
+		tcpm_vbus_change(p->tcpm_port);
+	}
+}
+
+static int pmi_typec_start_toggling(struct tcpc_dev *tcpc,
+				    enum typec_port_type port_type,
+				    enum typec_cc_status cc)
+{
+	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
+	struct pmic_typec_port *p = tcpm->pmic_typec_port;
+	unsigned long flags;
+	u8 role;
+	int ret;
+
+	switch (port_type) {
+	case TYPEC_PORT_SRC:
+		role = DFP_EN_CMD;
+		break;
+	case TYPEC_PORT_SNK:
+		role = UFP_EN_CMD;
+		break;
+	case TYPEC_PORT_DRP:
+	default:
+		role = 0;	/* DRP: hardware auto-toggle */
+		break;
+	}
+
+	spin_lock_irqsave(&p->lock, flags);
+	/* force at least one toggle: disable then set the mode */
+	ret = regmap_update_bits(p->regmap, p->base + PMI_PWR_ROLE_CTRL,
+				 TYPEC_PWR_ROLE_MASK, TYPEC_DISABLE_CMD);
+	if (!ret)
+		ret = regmap_update_bits(p->regmap, p->base + PMI_PWR_ROLE_CTRL,
+					 TYPEC_PWR_ROLE_MASK, role);
+	spin_unlock_irqrestore(&p->lock, flags);
+
+	/* backstop for a cable already attached before toggling (no CC edge) */
+	mod_delayed_work(system_wq, &p->attach_sync_work, msecs_to_jiffies(120));
+	return ret;
+}
+
+static irqreturn_t pmi_typec_isr(int irq, void *dev_id)
+{
+	struct pmic_typec_port_irq_data *d = dev_id;
+	struct pmic_typec_port *p = d->pmic_typec_port;
+
+	/* single type-c-change IRQ: let tcpm re-read CC + VBUS state */
+	if (p->tcpm_port) {
+		tcpm_cc_change(p->tcpm_port);
+		tcpm_vbus_change(p->tcpm_port);
+	}
+	return IRQ_HANDLED;
+}
+
+static int pmi_typec_port_start(struct pmic_typec *tcpm,
+				struct tcpm_port *tcpm_port)
+{
+	struct pmic_typec_port *p = tcpm->pmic_typec_port;
+	int i, ret;
+
+	/* enable all Type-C event sources feeding the single change IRQ */
+	ret = regmap_write(p->regmap, p->base + PMI_INTRPT_ENB, 0xff);
+	if (ret)
+		return ret;
+	/* start in DRP (hardware auto-toggle), VCONN under software control */
+	ret = regmap_update_bits(p->regmap, p->base + PMI_PWR_ROLE_CTRL,
+				 TYPEC_PWR_ROLE_MASK | VCONN_EN_SRC | VCONN_EN_VALUE,
+				 VCONN_EN_SRC);
+	if (ret)
+		return ret;
+
+	p->tcpm_port = tcpm_port;
+	for (i = 0; i < p->nr_irqs; i++)
+		enable_irq(p->irq_data[i].irq);
+	return 0;
+}
+
+static void pmi_typec_port_stop(struct pmic_typec *tcpm)
+{
+	struct pmic_typec_port *p = tcpm->pmic_typec_port;
+	int i;
+
+	for (i = 0; i < p->nr_irqs; i++)
+		disable_irq(p->irq_data[i].irq);
+	cancel_delayed_work_sync(&p->attach_sync_work);
+}
+
+int qcom_pmic_typec_port_pmi8998_probe(struct platform_device *pdev,
+				       struct pmic_typec *tcpm,
+				       const struct pmic_typec_port_resources *res,
+				       struct regmap *regmap,
+				       u32 base)
+{
+	struct device *dev = &pdev->dev;
+	struct pmic_typec_port_irq_data *irq_data;
+	struct pmic_typec_port *p;
+	int i, ret, irq;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	if (!res->nr_irqs || res->nr_irqs > PMIC_TYPEC_MAX_IRQS)
+		return -EINVAL;
+
+	irq_data = devm_kcalloc(dev, res->nr_irqs, sizeof(*irq_data), GFP_KERNEL);
+	if (!irq_data)
+		return -ENOMEM;
+
+	mutex_init(&p->vbus_lock);
+	spin_lock_init(&p->lock);
+	INIT_DELAYED_WORK(&p->attach_sync_work, pmi_typec_attach_sync_work);
+	p->dev = dev;
+	p->regmap = regmap;
+	p->base = base;
+	p->otg_base = base - 0x200;	/* USBIN 0x1300 -> OTG 0x1100 */
+	p->nr_irqs = res->nr_irqs;
+	p->irq_data = irq_data;
+
+	for (i = 0; i < res->nr_irqs; i++, irq_data++) {
+		irq = platform_get_irq_byname(pdev, res->irq_params[i].irq_name);
+		if (irq < 0)
+			return irq;
+		irq_data->pmic_typec_port = p;
+		irq_data->irq = irq;
+		ret = devm_request_threaded_irq(dev, irq, NULL, pmi_typec_isr,
+						IRQF_ONESHOT | IRQF_NO_AUTOEN,
+						res->irq_params[i].irq_name,
+						irq_data);
+		if (ret)
+			return ret;
+	}
+
+	tcpm->pmic_typec_port = p;
+	tcpm->tcpc.get_vbus = pmi_typec_get_vbus;
+	tcpm->tcpc.set_vbus = pmi_typec_set_vbus;
+	tcpm->tcpc.set_cc = pmi_typec_set_cc;
+	tcpm->tcpc.get_cc = pmi_typec_get_cc;
+	tcpm->tcpc.set_polarity = pmi_typec_set_polarity;
+	tcpm->tcpc.set_vconn = pmi_typec_set_vconn;
+	tcpm->tcpc.start_toggling = pmi_typec_start_toggling;
+	tcpm->port_start = pmi_typec_port_start;
+	tcpm->port_stop = pmi_typec_port_stop;
+	return 0;
+}
+
+const struct pmic_typec_port_resources pmi8998_port_res = {
+	.nr_irqs = 1,
+	.irq_params = {
+		{ .irq_name = "type-c-change" },
+	},
+};
